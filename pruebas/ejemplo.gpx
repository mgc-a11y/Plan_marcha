      <trkpt lat="42.2" lon="-0.5"><ele>110</ele></trkpt>
      <trkpt lat="42.3" lon="-0.5"><ele>150</ele></trkpt>
      <trkpt lat="42.4" lon="-0.5"><ele>150</ele></trkpt>
